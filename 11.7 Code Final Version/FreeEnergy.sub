# Prepared by Make_Jobs.jl (queue already set). On the cluster: cd into this task folder, then condor_submit FreeEnergy.sub
# The task folder must sit in BKT-plasma2D/ next to julia-1.12.6-linux-x86_64.tar.gz; folder names must not contain spaces.
# Total progress: grep -c COMPLETE logs/FreeEnergy_job*.out | awk -F: '{s+=$2} END {print s}'
# One job: tail -f logs/FreeEnergy_job<J>.<Cluster>.out
# Before download, merge: tar -cf FreeEnergy_results.tar logs/FreeEnergy_job*.tar.gz  (needs twice the disk while merging)
universe = vanilla
executable = run_FreeEnergy.sh
arguments = $(Process)

log = logs/FreeEnergy_job$(Process).$(Cluster).log
output = logs/FreeEnergy_job$(Process).$(Cluster).out
error = logs/FreeEnergy_job$(Process).$(Cluster).err
stream_output = True
stream_error = True

should_transfer_files = YES
when_to_transfer_output = ON_EXIT_OR_EVICT
transfer_input_files = ../julia-1.12.6-linux-x86_64.tar.gz, Project.toml, Manifest.toml, Setup.jl, Plasma_Interaction.jl, Monte_Carlo.jl, Free_Energy.jl, Output_FreeEnergy.jl, FreeEnergy_jobs.csv
transfer_output_files = FreeEnergy_results.tar.gz
transfer_output_remaps = "FreeEnergy_results.tar.gz=logs/FreeEnergy_job$(Process)_$(Cluster).tar.gz"

request_cpus = 1
# Memory: N=50 nodes keep only energies; a local N=200 dielectric run peaked at 0.60 GB (11.7);
# 11.3 cluster jobs peaked at 2.02 GB. 4 GB leaves room for Julia/JIT and packing.
request_memory = 4GB
retry_request_memory = 6GB, 8GB
# Disk: Julia archive 0.29 GB + extracted 1.06 GB + depot 0.12 GB (11.7, with Interpolations)
# + results x3 (one node writes 32 kB of energies) = about 1.5 GB; 4 GB leaves margin.
request_disk = 4GB
requirements = (OpSys == "LINUX") && (Arch == "X86_64")
max_retries = 2
notification = Never
+JobBatchName = "BKT_FreeEnergy"

queue 1
