# 24 independent jobs: 6 replicates (1-3 hot start, 4-6 cold start) x 4 blocks of the 483-point grid.
# Submit from the access point with: condor_submit wide_scan.sub
# To test first, keep only one line in the queue block (e.g. "1 hot 1 121 r1hot_a") and submit that.
universe = vanilla
initialdir = /home/ljin62/BKT-plasma2D/10.27_Wide_SQQ_Scan
executable = run_wide_scan.sh
arguments = $(rep) $(init) $(start_id) $(end_id) $(tag)

log = logs/wide_$(tag).$(Cluster).$(Process).log
output = logs/wide_$(tag).$(Cluster).$(Process).out
error = logs/wide_$(tag).$(Cluster).$(Process).err
stream_output = True
stream_error = True

should_transfer_files = YES
when_to_transfer_output = ON_EXIT_OR_EVICT
transfer_input_files = /home/ljin62/BKT-plasma2D/julia-1.12.6-linux-x86_64.tar.gz, Project.toml, Manifest.toml, Setup.jl, Plasma_Interaction.jl, Monte_Carlo.jl, Wide_Scan.jl, read_scan.py
transfer_output_files = scan_results.tar.gz
transfer_output_remaps = "scan_results.tar.gz=logs/wide_$(tag)_$(Cluster)_$(Process).tar.gz"
environment = "CHECKPOINT_SECONDS=900"

request_cpus = 1
request_memory = 4GB
retry_request_memory = 6GB, 8GB
request_disk = 8GB
requirements = (OpSys == "LINUX") && (Arch == "X86_64")
notification = Never
+JobBatchName = "BKT_10.27_wide_N50_rho0p05"

queue rep, init, start_id, end_id, tag from (
    1  hot   1    121  r1hot_a
    1  hot   122  242  r1hot_b
    1  hot   243  363  r1hot_c
    1  hot   364  483  r1hot_d
    2  hot   1    121  r2hot_a
    2  hot   122  242  r2hot_b
    2  hot   243  363  r2hot_c
    2  hot   364  483  r2hot_d
    3  hot   1    121  r3hot_a
    3  hot   122  242  r3hot_b
    3  hot   243  363  r3hot_c
    3  hot   364  483  r3hot_d
    4  cold  1    121  r4cold_a
    4  cold  122  242  r4cold_b
    4  cold  243  363  r4cold_c
    4  cold  364  483  r4cold_d
    5  cold  1    121  r5cold_a
    5  cold  122  242  r5cold_b
    5  cold  243  363  r5cold_c
    5  cold  364  483  r5cold_d
    6  cold  1    121  r6cold_a
    6  cold  122  242  r6cold_b
    6  cold  243  363  r6cold_c
    6  cold  364  483  r6cold_d
)
